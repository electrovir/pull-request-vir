{
    "name": "pull-request-vir",
    "version": "1.1.2",
    "description": "GitHub Action for pull requests",
    "keywords": [
        "github",
        "actions",
        "pull request",
        "review",
        "automated"
    ],
    "homepage": "https://github.com/electrovir/pull-request-vir",
    "bugs": {
        "url": "https://github.com/electrovir/pull-request-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/electrovir/pull-request-vir"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "compile": "rm -rf dist && tsc --pretty",
        "docs": "virmator docs",
        "format": "virmator format",
        "publish": "virmator publish \"npm run compile && npm run test:all\"",
        "start": "node src/action/action-entry-point.js",
        "test": "mocha --colors --config 'configs/mocha.config.cjs'",
        "test:all": "concurrently --colors --kill-others-on-fail -c auto --names types,tests,spelling,format,docs,deps \"npm run test:types\" \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:spelling": "virmator spellcheck",
        "test:types": "tsc --noEmit --pretty"
    },
    "dependencies": {
        "@actions/core": "^1.10.1",
        "@actions/github": "^6.0.0",
        "@augment-vir/common": "^28.2.2",
        "@augment-vir/node-js": "^28.2.2",
        "@octokit/core": "^6.1.2",
        "@octokit/openapi-types": "^22.2.0",
        "@octokit/rest": "^20.1.1",
        "@review-vir/common": "^1.0.3",
        "date-vir": "^5.3.2",
        "object-shape-tester": "^2.4.0",
        "run-time-assertions": "^1.5.1",
        "simple-git": "^3.25.0",
        "tsx": "^4.15.6",
        "type-fest": "^4.20.1"
    },
    "devDependencies": {
        "@electrovir/nyc": "^15.1.0-fix0",
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@types/chai": "^4.3.16",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.14.5",
        "chai": "^5.1.0",
        "cspell": "^8.9.0",
        "dependency-cruiser": "^16.3.3",
        "esbuild": "^0.21.5",
        "execute-in-browser": "^1.0.1",
        "istanbul-smart-text-reporter": "^1.1.4",
        "markdown-code-example-inserter": "^1.0.0",
        "mocha": "^10.4.0",
        "mocha-spec-reporter-with-file-names": "^0.0.3",
        "npm-check-updates": "~16.12.3",
        "prettier": "^3.3.2",
        "prettier-plugin-interpolated-html-tags": "^1.0.5",
        "prettier-plugin-jsdoc": "^1.3.0",
        "prettier-plugin-multiline-arrays": "^3.0.6",
        "prettier-plugin-organize-imports": "^3.2.4",
        "prettier-plugin-packagejson": "^2.5.0",
        "prettier-plugin-sort-json": "^4.0.0",
        "prettier-plugin-toml": "^2.0.1",
        "ts-node": "^10.9.2",
        "typedoc": "^0.25.13",
        "typescript": "^5.4.5",
        "virmator": "^12.0.1"
    },
    "peerDependencies": {
        "virmator": "*"
    }
}
