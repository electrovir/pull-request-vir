{
    "name": "pull-request-vir",
    "version": "1.2.0",
    "description": "GitHub Action for pull requests",
    "keywords": [
        "github",
        "actions",
        "pull request",
        "review",
        "automated"
    ],
    "homepage": "https://github.com/electrovir/pull-request-vir",
    "bugs": {
        "url": "https://github.com/electrovir/pull-request-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/pull-request-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "node src/action/action-entry-point.js",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@actions/core": "^1.11.0",
        "@actions/github": "^6.0.0",
        "@augment-vir/assert": "^30.2.0",
        "@augment-vir/common": "^30.2.0",
        "@augment-vir/node": "^30.2.0",
        "@octokit/core": "^6.1.2",
        "@octokit/openapi-types": "^22.2.0",
        "@octokit/rest": "^21.0.2",
        "@review-vir/common": "^1.0.3",
        "date-vir": "^6.0.1",
        "object-shape-tester": "^3.0.0",
        "simple-git": "^3.27.0",
        "tsx": "^4.19.1",
        "type-fest": "^4.26.1"
    },
    "devDependencies": {
        "@augment-vir/test": "^30.2.0",
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.10.0",
        "@stylistic/eslint-plugin": "^2.8.0",
        "@stylistic/eslint-plugin-ts": "^2.8.0",
        "@types/node": "^22.7.4",
        "@typescript-eslint/eslint-plugin": "^8.5.0",
        "cspell": "^8.14.4",
        "dependency-cruiser": "^16.4.2",
        "esbuild": "^0.24.0",
        "eslint": "^9.10.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jsdoc": "^50.2.3",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^1.6.2",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^2.0.2",
        "eslint-plugin-unicorn": "^55.0.0",
        "execute-in-browser": "^1.0.3",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.0",
        "mock-vir": "^1.0.0",
        "npm-check-updates": "^17.1.3",
        "prettier": "^3.3.3",
        "prettier-plugin-interpolated-html-tags": "^1.0.5",
        "prettier-plugin-jsdoc": "^1.3.0",
        "prettier-plugin-multiline-arrays": "^3.0.6",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.2",
        "prettier-plugin-sort-json": "^4.0.0",
        "prettier-plugin-toml": "^2.0.1",
        "typedoc": "^0.26.8",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.5.0",
        "virmator": "^13.4.1"
    },
    "peerDependencies": {
        "virmator": "*"
    },
    "engines": {
        "node": ">=18"
    }
}
