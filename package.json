{
    "name": "pull-request-vir",
    "version": "1.4.6",
    "description": "GitHub Action for pull requests",
    "keywords": [
        "github",
        "actions",
        "pull request",
        "review",
        "automated"
    ],
    "homepage": "https://github.com/electrovir/pull-request-vir",
    "bugs": {
        "url": "https://github.com/electrovir/pull-request-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/pull-request-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "node src/action/action-entry-point.js",
        "test": "virmator test node",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "@augment-vir/assert": "^31.40.0",
        "@augment-vir/common": "^31.40.0",
        "@augment-vir/node": "^31.40.0",
        "@octokit/core": "^7.0.5",
        "@octokit/openapi-types": "^26.0.0",
        "@octokit/rest": "^22.0.0",
        "@review-vir/common": "^3.0.0",
        "date-vir": "^8.0.0",
        "object-shape-tester": "^6.9.2",
        "simple-git": "^3.28.0",
        "tsx": "^4.20.6",
        "type-fest": "^5.1.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.40.0",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.37.0",
        "@stylistic/eslint-plugin": "^5.4.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^24.7.2",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "cspell": "^9.2.1",
        "dependency-cruiser": "^17.0.2",
        "esbuild": "^0.25.10",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^61.1.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.5",
        "eslint-plugin-unicorn": "^57.0.0",
        "execute-in-browser": "^1.0.9",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "mock-vir": "^2.0.1",
        "npm-check-updates": "^19.0.0",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.3",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^2.5.19",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^0.6.2",
        "typedoc": "^0.28.14",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.1",
        "virmator": "^14.1.0"
    },
    "peerDependencies": {
        "virmator": "*"
    },
    "engines": {
        "node": ">=18"
    }
}
